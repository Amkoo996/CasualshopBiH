rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper funkcija za provjeru admin prava
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // ==========================================
    // PROIZVODI (PRODUCTS)
    // ==========================================
    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      
      // Admin mijenja sve, a kupci pri kupovini mogu samo smanjivati zalihe
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sizes'])
      );
    }

    // ==========================================
    // NARUDŽBE (ORDERS) - ZAKLJUČANO ZA JAVNOST
    // ==========================================
    match /orders/{orderId} {
      // Svako može napraviti narudžbu, ali samo sa tačno definisanim poljima
      allow create: if request.resource.data.keys().hasOnly([
        'orderNumber', 'items', 'customer', 'subtotal', 'shippingFee', 
        'total', 'paymentMethod', 'status', 'createdAt', 'promoCode', 'discountAmount'
      ]);
      
      // Čitanje, izmjena i brisanje narudžbi dozvoljeni su ISKLJUČIVO adminu
      allow read, update, delete: if isAdmin();
    }

    // ==========================================
    // SIGURNO PRAĆENJE NARUDŽBI (ORDER TRACKING)
    // ==========================================
    match /order_tracking/{orderNumber} {
      // Kupci mogu dohvatiti pojedinačni dokument po broju narudžbe
      allow get: if true;
      
      // Listanje svih praćenja dozvoljeno samo adminu
      allow list: if isAdmin();
      
      // Kreiranje pri narudžbi (samo anonimizirani podaci sa statusom 'Nova')
      allow create: if request.resource.data.keys().hasOnly([
        'orderNumber', 'status', 'phoneHash', 'createdAt'
      ]) && request.resource.data.status == 'Nova';
      
      // Ažuriranje statusa praćenja i brisanje dozvoljeno samo adminu
      allow update, delete: if isAdmin();
    }

    // ==========================================
    // PROMO KODOVI (PROMO CODES)
    // ==========================================
    match /promo_codes/{codeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==========================================
    // KONTAKT PORUKE (CONTACT MESSAGES)
    // ==========================================
    match /contact_messages/{messageId} {
      allow create: if request.resource.data.keys().hasOnly([
        'name', 'email', 'phone', 'message', 'createdAt', 'read'
      ]);
      allow read, update, delete: if isAdmin();
    }

    // ==========================================
    // NEWSLETTER PRETPATNICI (SUBSCRIBERS)
    // ==========================================
    match /subscribers/{email} {
      allow create, update: if request.resource.data.keys().hasOnly([
        'email', 'subscribedAt', 'createdAt', 'consent'
      ]);
      allow read, delete: if isAdmin();
    }

    // ==========================================
    // RECENZIJE PROIZVODA (REVIEWS)
    // ==========================================
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly([
        'productId', 'author', 'rating', 'comment', 'createdAt'
      ]);
      allow update, delete: if isAdmin();
    }

    // ==========================================
    // POSTAVKE I CMS (SETTINGS)
    // ==========================================
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

  }
}
