rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper funkcija za provjeru admin prava
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == 'Jt35lHyxq1feiEyi1exOKRA9xJl2' || 
        request.auth.uid == 'NSgdcTOFwXRW3nVfHa9mvgfXsDC3' || 
        request.auth.token.admin == true
      );
    }

    // Helper funkcija: osigurava da kupac moze samo smanjiti zalihu (K1 fix)
    function sizeOk(s) {
      return !(s in request.resource.data.sizes) || (
        !(s in resource.data.sizes) || (
          request.resource.data.sizes[s] is int &&
          request.resource.data.sizes[s] >= 0 &&
          request.resource.data.sizes[s] <= resource.data.sizes[s]
        )
      );
    }

    // ==========================================
    // PROIZVODI (PRODUCTS)
    // ==========================================
    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      
      // Admin mijenja sve; Kupci pri kupovini mogu iskljucivo smanjiti postojece zalihe
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sizes']) &&
        sizeOk('S') && sizeOk('M') && sizeOk('L') && sizeOk('XL') &&
        sizeOk('XXL') && sizeOk('3XL') && sizeOk('One size')
      );
    }

    // ==========================================
    // NARUDzBE (ORDERS) - ZAKLJUcANO ZA JAVNOST
    // ==========================================
    match /orders/{orderId} {
      allow create: if request.resource.data.keys().hasOnly([
        'orderNumber', 'items', 'customer', 'subtotal', 'shippingFee', 
        'total', 'paymentMethod', 'status', 'createdAt', 'promoCode', 'discountAmount'
      ]) && request.resource.data.status == 'Nova'
         && request.resource.data.total >= 0;

      allow read, update, delete: if isAdmin();
    }

    // ==========================================
    // SIGURNO PRAcENJE NARUDzBI (ORDER TRACKING)
    // ==========================================
    match /order_tracking/{orderNumber} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly([
        'orderNumber', 'status', 'phoneHash', 'createdAt'
      ]) && request.resource.data.status == 'Nova';
      allow update, delete: if isAdmin();
    }

    // ==========================================
    // ANALITIKA I METRIKE - STRATIFIKOVANO SVE ZA ADMINA (V1)
    // ==========================================
    match /analytics_events/{eventId} {
      allow create: if true; // Kupci Salju event pri posjeti
      allow read, update, delete: if isAdmin();
    }

    match /product_stats/{statId} {
      allow create, update: if true;
      allow read, delete: if isAdmin();
    }

    match /store_metrics/{metricId} {
      allow create, update: if true;
      allow read, delete: if isAdmin();
    }

    match /abandoned_carts/{cartId} {
      allow create, update: if true;
      allow read, delete: if isAdmin();
    }

    // ==========================================
    // PROMO KODOVI (PROMO CODES) - SPREcAVANJE CURENJA (K3 fix)
    // ==========================================
    match /promo_codes/{codeId} {
      // Kupac moze dohvatiti samo konkretan kod pri unosa u checkout (get), ali NE MOzE listati sve kodove (list)
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // ==========================================
    // KONTAKT PORUKE (CONTACT MESSAGES)
    // ==========================================
    match /contact_messages/{messageId} {
      allow create: if request.resource.data.keys().hasOnly([
        'name', 'email', 'phone', 'message', 'createdAt', 'read'
      ]) && request.resource.data.message.size() <= 2000;

      allow read, update, delete: if isAdmin();
    }

    // ==========================================
    // NEWSLETTER PRETPATNICI (SUBSCRIBERS) - ONEMOGUcENO PREPISIVANJE (V4 fix)
    // ==========================================
    match /subscribers/{email} {
      // Onemogucen update anonimnim korisnicima kako ne bi mogli mijenjati/prepisivati tuđe e-mailove
      allow create: if request.resource.data.keys().hasOnly([
        'email', 'subscribedAt', 'createdAt', 'consent'
      ]);
      allow read, update, delete: if isAdmin();
    }

    // ==========================================
    // RECENZIJE PROIZVODA (REVIEWS) - STRATESKA VALIDACIJA (V3 fix)
    // ==========================================
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly([
        'productId', 'author', 'rating', 'comment', 'createdAt'
      ]) && request.resource.data.rating is int
         && request.resource.data.rating >= 1
         && request.resource.data.rating <= 5
         && request.resource.data.comment.size() <= 1000;

      allow update, delete: if isAdmin();
    }

    // ==========================================
    // POSTAVKE I CMS (SETTINGS)
    // ==========================================
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

  }
}
