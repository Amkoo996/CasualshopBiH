rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function validSize(k) {
      let o = resource.data.sizes.get(k, 0);
      let n = request.resource.data.sizes.get(k, 0);
      return n is int && n >= 0 && n <= o;
    }

    // Defaultno sve zabranjeno
    match /{document=**} { allow read, write: if false; }

    // Admini
    match /admins/{adminId} {
      allow read: if isSignedIn() && request.auth.uid == adminId;
      allow write: if false;
    }

    // Postavke sajta
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Proizvodi - Čitanje svima, promjena zaliha pri kupovini, ostalo samo Admin
    match /products/{docId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sizes'])
        && request.resource.data.sizes.keys().hasOnly(['S', 'M', 'L', 'XL', 'XXL', '3XL', 'One size'])
        && validSize('S') && validSize('M') && validSize('L') && validSize('XL')
        && validSize('XXL') && validSize('3XL') && validSize('One size')
      );
    }

    // Narudžbe - Kupac kreira i pretražuje po broju/telefonu, Admin ima puni pristup
    match /orders/{docId} {
      allow create: if request.resource.data.keys().hasAll(['orderNumber', 'items', 'customer', 'subtotal', 'shippingFee', 'total', 'paymentMethod', 'status'])
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 20
        && request.resource.data.customer is map
        && request.resource.data.customer.phone is string
        && request.resource.data.customer.phone.size() >= 6
        && request.resource.data.customer.phone.size() <= 20
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.total < 10000
        && request.resource.data.paymentMethod == 'cash_on_delivery'
        && request.resource.data.status == 'Nova';
      
      // Dozvoljavamo čitanje svima kako bi radila forma "Prati svoju narudžbu" na sajtu
      allow read: if true; 
      allow update, delete: if isAdmin();
    }

    // Newsletter
    match /subscribers/{docId} {
      allow create: if request.resource.data.email is string
        && request.resource.data.email.size() <= 150;
      allow read, update, delete: if isAdmin();
    }

    // Promo kodovi - Čitanje svima (provjera koda), kreiranje i izmjena SAMO Admin
    match /promo_codes/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Recenzije
    match /reviews/{docId} {
      allow read: if true;
      allow create: if request.resource.data.rating is number
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 2000;
      allow update, delete: if isAdmin();
    }

    // Lista želja
    match /wishlists/{userId} {
      allow read, write: if true; // Prilagođeno za goste i korisnike
    }

    // Kontakt poruke
    match /contact_messages/{docId} {
      allow create: if request.resource.data.size() <= 10
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 2000;
      allow read, update, delete: if isAdmin();
    }

    // Analitika i napuštene korpe
    match /analytics_events/{docId} {
      allow create: if request.resource.data.size() <= 10;
      allow read, delete: if isAdmin();
    }

    match /store_metrics/{docId} {
      allow read: if isAdmin();
      allow create, update: if request.resource.data.size() <= 10;
    }

    match /abandoned_carts/{docId} {
      allow create, update: if request.resource.data.size() <= 15;
      allow read, delete: if isAdmin();
    }
  }
}
