rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // zaliha smije samo opadati i ne ispod 0
    function validSize(k) {
      let o = resource.data.sizes.get(k, 0);
      let n = request.resource.data.sizes.get(k, 0);
      return n is int && n >= 0 && n <= o;
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sizes'])
        && request.resource.data.sizes.keys().hasOnly(['S', 'M', 'L', 'XL', 'One size'])
        && validSize('S') && validSize('M') && validSize('L')
        && validSize('XL') && validSize('One size')
      );
    }

    match /orders/{orderId} {
      allow create: if request.resource.data.keys().hasAll(['orderNumber', 'items', 'customer', 'subtotal', 'shippingFee', 'total', 'paymentMethod', 'status'])
        && request.resource.data.keys().hasOnly(['orderNumber', 'items', 'customer', 'subtotal', 'shippingFee', 'total', 'paymentMethod', 'status', 'createdAt'])
        && request.resource.data.orderNumber is string
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 20
        && request.resource.data.customer is map
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.total < 10000
        && request.resource.data.paymentMethod == 'cash_on_delivery'
        && request.resource.data.status == 'Nova';
      allow read, update, delete: if isAdmin();
    }

    match /subscribers/{subscriberId} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'consent', 'subscribedAt'])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 150
        && request.resource.data.consent == true;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /store_metrics/{metricId} {
      allow read: if isAdmin();
      allow create, update: if request.resource.data.keys().hasOnly(['totalVisits', 'productViews', 'addToCartCount', 'checkoutStarts', 'completedPurchases']);
    }

    match /analytics_events/{eventId} {
      allow create: if request.resource.data.keys().hasAll(['eventType', 'visitorId', 'timestamp', 'date'])
        && request.resource.data.keys().hasOnly(['eventType', 'visitorId', 'timestamp', 'date', 'metadata'])
        && request.resource.data.eventType is string
        && request.resource.data.visitorId is string
        && request.resource.data.visitorId.size() <= 100
        && request.resource.data.timestamp is string
        && request.resource.data.date is string;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    match /abandoned_carts/{cartId} {
      allow create, update: if request.resource.data.size() <= 15;
      allow read, delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['productId', 'userName', 'rating', 'comment', 'createdAt'])
        && request.resource.data.productId is string
        && request.resource.data.userName is string && request.resource.data.userName.size() <= 100
        && request.resource.data.rating is number && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.comment is string && request.resource.data.comment.size() <= 2000;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /wishlists/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /admins/{adminId} {
      allow read: if isSignedIn() && request.auth.uid == adminId;
      allow write: if false;
    }
  }
}
