rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. KORISNICI I ADMINI (FIX ZA LOGIN ERROR):
    // Dozvoljava prijavljenom korisniku da pročita svoj vlastiti profil/rolu
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }
    
    match /admins/{adminId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 2. POSTAVKE (SETTINGS):
    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 3. PROIZVODI (PRODUCTS):
    match /products/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 4. PROMO KODOVI:
    match /promo_codes/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 5. NARUDŽBE:
    match /orders/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // 6. NEWSLETTER pretplatnici:
    match /subscribers/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // 7. RECENZIJE:
    match /reviews/{docId} {
      allow read, create: if true;
      allow update, delete: if request.auth != null;
    }

    // 8. LISTA ŽELJA:
    match /wishlists/{docId} {
      allow read, write: if true;
    }
  }
}
