rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper funkcija za provjeru admin prava
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == 'Jt35lHyxq1feiEyi1exOKRA9xJl2' || 
        request.auth.uid == 'NSgdcTOFwXRW3nVfHa9mvgfXsDC3' || 
        request.auth.token.admin == true
      );
    }

    // ==========================================
    // PROIZVODI (PRODUCTS)
    // ==========================================
    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      
      // Admin mijenja sve, kupci pri kupovini samo smanjuju zalihe
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sizes'])
      );
    }

    // ==========================================
    // NARUDŽBE (ORDERS) - ZAKLJUČANO
    // ==========================================
    match /orders/{orderId} {
      allow create: if request.resource.data.keys().hasOnly([
        'orderNumber', 'items', 'customer', 'subtotal', 'shippingFee', 
        'total', 'paymentMethod', 'status', 'createdAt', 'promoCode', 'discountAmount'
      ]);
      allow read, update, delete: if isAdmin();
    }

    // ==========================================
    // SIGURNO PRAĆENJE NARUDŽBI (ORDER TRACKING)
    // ==========================================
    match /order_tracking/{orderNumber} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly([
        'orderNumber', 'status', 'phoneHash', 'createdAt'
      ]) && request.resource.data.status == 'Nova';
      allow update, delete: if isAdmin();
    }

    // ==========================================
    // ANALITIKA I METRIKE - STRATIFIKOVANO SVE ZA ADMINA
    // ==========================================
    match /analytics_events/{eventId} {
      allow create: if true; // Kupci šalju event pri posjeti
      allow read, update, delete: if isAdmin(); // Čitanje ISKLJUČIVO za admina
    }

    match /product_stats/{statId} {
      // Kupac može samo inkrementirati brojač pregleda, bez mogućnosti čitanja svih statistika
      allow create, update: if true;
      allow read, delete: if isAdmin(); // Čitanje ISKLJUČIVO za admina
    }

    match /store_metrics/{metricId} {
      allow create, update: if true;
      allow read, delete: if isAdmin(); // Čitanje ISKLJUČIVO za admina
    }

    match /abandoned_carts/{cartId} {
      allow create, update: if true; // Kupac bilježi stavke u korpi
      allow read, delete: if isAdmin(); // Čitanje ISKLJUČIVO za admina (Leads tab)
    }

    // ==========================================
    // PROMO KODOVI (PROMO CODES)
    // ==========================================
    match /promo_codes/{codeId} {
      allow read: if true; // Kupci provjeravaju da li kod važi pri checkoutu
      allow write: if isAdmin();
    }

    // ==========================================
    // KONTAKT PORUKE (CONTACT MESSAGES)
    // ==========================================
    match /contact_messages/{messageId} {
      allow create: if request.resource.data.keys().hasOnly([
        'name', 'email', 'phone', 'message', 'createdAt', 'read'
      ]);
      allow read, update, delete: if isAdmin();
    }

    // ==========================================
    // NEWSLETTER PRETPATNICI (SUBSCRIBERS)
    // ==========================================
    match /subscribers/{email} {
      allow create, update: if request.resource.data.keys().hasOnly([
        'email', 'subscribedAt', 'createdAt', 'consent'
      ]);
      allow read, delete: if isAdmin();
    }

    // ==========================================
    // RECENZIJE PROIZVODA (REVIEWS)
    // ==========================================
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly([
        'productId', 'author', 'rating', 'comment', 'createdAt'
      ]);
      allow update, delete: if isAdmin();
    }

    // ==========================================
    // POSTAVKE I CMS (SETTINGS)
    // ==========================================
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

  }
}
