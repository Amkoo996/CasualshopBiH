rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == 'Jt35lHyxq1feiEyi1exOKRA9xJl2' || 
        request.auth.uid == 'NSgdcTOFwXRW3nVfHa9mvgfXsDC3' || 
        request.auth.token.admin == true
      );
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow read, write: if isAdmin();
    }

    match /order_tracking/{orderNumber} {
      allow get: if true;
      allow list, write: if isAdmin();
    }

    match /promo_codes/{codeId} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    match /abandoned_carts/{cartId} {
      allow create, update: if request.resource.data.keys().hasOnly([
        'customerName', 'phone', 'email', 'city', 'address', 'deliveryMethod', 
        'items', 'itemsSummary', 'total', 'updatedAt', 'status'
      ]) && request.resource.data.items is list
         && request.resource.data.items.size() <= 20;
         
      allow read, delete: if isAdmin();
    }

    match /analytics_events/{eventId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /product_stats/{statId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['productId', 'viewsCount', 'lastViewedAt']);
      allow delete: if isAdmin();
    }

    match /store_metrics/{metricId} {
      allow read, delete: if isAdmin();
      allow create, update: if request.resource.data.keys().hasOnly([
        'totalVisits', 'productViews', 'addToCartCount', 'checkoutStarts', 'completedPurchases'
      ]);
    }
    
    match /product_views/{viewId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }
    
    match /views/{viewId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    match /contact_messages/{messageId} {
      allow create: if request.resource.data.keys().hasOnly([
        'name', 'email', 'phone', 'message', 'createdAt', 'read'
      ]) && request.resource.data.message is string
         && request.resource.data.message.size() <= 2000;

      allow read, update, delete: if isAdmin();
    }

    match /subscribers/{email} {
      allow create: if request.resource.data.keys().hasOnly([
        'email', 'subscribedAt', 'createdAt', 'consent'
      ]) && request.resource.data.email is string
         && request.resource.data.email.size() <= 100;

      allow read, update, delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly([
        'productId', 'author', 'userName', 'rating', 'comment', 'createdAt'
      ]) && request.resource.data.rating is int
         && request.resource.data.rating >= 1
         && request.resource.data.rating <= 5
         && request.resource.data.comment is string
         && request.resource.data.comment.size() <= 1000
         && request.resource.data.author is string
         && request.resource.data.author.size() <= 60;

      allow update, delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
